{
  "name": "@akka-human/kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "React components and headless hooks for human-oversight events served at /oversight.",
  "sideEffects": ["*.css"],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./kit.css": {
      "source": "./src/kit.css",
      "default": "./dist/kit.css"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').copyFileSync('src/kit.css','dist/kit.css')\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "valibot": "1.4.2"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.2.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.12.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "jsdom": "29.1.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "typescript": "5.8.3",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  }
}
